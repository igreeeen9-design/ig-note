---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  hero?: boolean;
  /** OGP画像。サイト内のパス(例: /ig-note/images/...)か絶対URL。省略時はタイトルバナー */
  image?: string;
  /** OGPの種類。記事ページは 'article' */
  type?: 'website' | 'article';
}

const {
  title,
  description = '48歳から、いろいろやってみる個人サイト「DEKIRUKANA.」。草野球、AI、サイト作りなど、思いついたことをやってみる記録です。',
  hero = false,
  image = `${import.meta.env.BASE_URL}images/site/title-banner.jpg`,
  type = 'website',
} = Astro.props;

// 検索エンジン・SNS向けに、base path(/ig-note/)込みの絶対URLにする
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="DEKIRUKANA." />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" type="application/xml" href={`${import.meta.env.BASE_URL}sitemap.xml`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}icons/dekirukana-favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}icons/dekirukana-apple-touch-180.png`} sizes="180x180" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <div class="wrap">
      <Header hero={hero} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script define:vars={{ base: import.meta.env.BASE_URL }}>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(`${base}sw.js`, { scope: base }).catch(() => {
            // オフライン対応が使えなくても、サイトの表示自体には影響しない
          });
        });
      }
    </script>
    <!--
      アクセス解析: GoatCounter(DEKIRUKANA.専用サイト dekirukana)。フルフェイスとは別集計。
      公開ページはすべてこのレイアウトを通るので、ここ1か所だけに置く(二重計測しない)。
      管理画面(public/admin/)はこのレイアウトを使わないため計測されないが、
      念のため /ig-note/admin/ 配下では送信しない。localhostでの閲覧はcount.js側で計測されない。
    -->
    <script define:vars={{ base: import.meta.env.BASE_URL }}>
      window.goatcounter = {
        path: (path) => (path.startsWith(`${base}admin/`) ? null : path),
      };
    </script>
    <script
      is:inline
      data-goatcounter="https://dekirukana.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"
    ></script>
  </body>
</html>
