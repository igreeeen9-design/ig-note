---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  hero?: boolean;
}

const {
  title,
  description = '48歳から、いろいろやってみる個人サイト「DEKIRUKANA.」。草野球、AI、サイト作りなど、思いついたことをやってみる記録です。',
  hero = false,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}icons/dekirukana-favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}icons/dekirukana-apple-touch-180.png`} sizes="180x180" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <div class="wrap">
      <Header hero={hero} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script define:vars={{ base: import.meta.env.BASE_URL }}>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(`${base}sw.js`, { scope: base }).catch(() => {
            // オフライン対応が使えなくても、サイトの表示自体には影響しない
          });
        });
      }
    </script>
  </body>
</html>
