---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { publishedLogs } from '../../public/admin/log-data.js';
const logs = publishedLogs(await getCollection('logs'));
---
<BaseLayout title="LOG - DEKIRUKANA." description="日々の、記事にするほどでもないこと。">
  <header class="post-header">
    <h1 class="post-title">LOG</h1>
    <p class="section-text">日々の、記事にするほどでもないこと。</p>
  </header>
  {logs.length === 0 ? <p class="section-text">まだ記録はありません。書きたい日に、少しずつ。</p> : (
    <ol class="log-timeline">
      {logs.map((log) => (
        <li id={`log-${log.id}`}>
          <article aria-label={`${log.data.date}の記録`}>
            <a class="log-date" href={`#log-${log.id}`}><time datetime={log.data.date}>{log.data.date.replaceAll('-', '.')}</time></a>
            <p class="log-body">{log.data.body}</p>
            {log.data.photo && <img class="log-photo" src={log.data.photo} alt={`${log.data.date}の記録に添えた写真`} loading="lazy" decoding="async" />}
          </article>
        </li>
      ))}
    </ol>
  )}
</BaseLayout>
<style>
  .log-timeline { list-style: none; margin: 32px 0 0 6px; padding: 0 0 0 26px; border-left: 1px solid var(--rule); }
  .log-timeline li { position: relative; padding: 0 0 32px; margin: 0 0 32px; border-bottom: 1px solid var(--rule); scroll-margin-top: 24px; }
  .log-timeline li::before { content: ''; position: absolute; left: -31px; top: 9px; width: 7px; height: 7px; border-radius: 50%; background: var(--heading); border: 1px solid var(--paper); }
  .log-date { color: var(--heading); font-size: .85rem; font-weight: 700; letter-spacing: .08em; text-decoration: none; font-variant-numeric: tabular-nums; }
  .log-body { white-space: pre-wrap; overflow-wrap: anywhere; margin: 14px 0 0; line-height: 2; font-weight: 500; }
  .log-photo { display: block; max-width: 100%; max-height: 560px; width: auto; height: auto; margin: 20px 0 0; border-radius: 3px; }
  @media (max-width: 480px) { .log-timeline { padding-left: 18px; } .log-timeline li::before { left: -23px; } }
</style>
