---
import BaseLayout from '../layouts/BaseLayout.astro';

// 送信先はFormspree。受信用メールアドレスはFormspree側でだけ設定し、サイトには書かない。
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xvkgbyao';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="お問い合わせ - DEKIRUKANA." description="DEKIRUKANA.へのご質問・ご感想はこちらのフォームからお送りください。">
  <header class="contact-header">
    <img
      class="contact-logo"
      src={`${base}icons/dekirukana-large-192.png`}
      width="192"
      height="192"
      alt="DEKIRUKANA."
    />
    <h1 class="post-title">お問い合わせ</h1>
    <p class="section-text">ご質問・ご感想などありましたら、こちらからお気軽にお送りください。</p>
  </header>

  <form class="contact-form" action={FORMSPREE_ENDPOINT} method="POST">
    <div class="contact-field">
      <label for="contact-name">お名前<span class="contact-required">必須</span></label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required />
    </div>

    <div class="contact-field">
      <label for="contact-email">メールアドレス<span class="contact-required">必須</span></label>
      <input id="contact-email" name="email" type="email" autocomplete="email" inputmode="email" required />
    </div>

    <div class="contact-field">
      <label for="contact-message">お問い合わせ内容<span class="contact-required">必須</span></label>
      <textarea id="contact-message" name="message" rows="7" required></textarea>
    </div>

    <!-- 通知メールの件名 -->
    <input type="hidden" name="_subject" value="DEKIRUKANA. お問い合わせ" />
    <!-- スパム対策(ハニーポット): 人には見えない欄。ここに入力があるとFormspreeが破棄する -->
    <div class="contact-honeypot" aria-hidden="true">
      <label>この欄は空のままにしてください<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
    </div>

    <p class="contact-status" role="status" aria-live="polite" hidden></p>

    <button type="submit" class="contact-submit">送信する</button>
  </form>

  <div class="contact-thanks" tabindex="-1" hidden>
    <p>お問い合わせありがとうございました。</p>
  </div>
</BaseLayout>

<script>
  // ページを移動せずに送信し、結果をこのページ内に表示する。
  // JavaScriptが動かない環境では、通常のフォーム送信(Formspreeの完了ページ)になる。
  const TIMEOUT_MS = 15000;

  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const thanks = document.querySelector<HTMLElement>('.contact-thanks');

  if (form && thanks) {
    const button = form.querySelector<HTMLButtonElement>('.contact-submit')!;
    const status = form.querySelector<HTMLElement>('.contact-status')!;
    let sending = false;

    const setSending = (value: boolean) => {
      sending = value;
      button.disabled = value;
      button.textContent = value ? '送信中…' : '送信する';
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return; // 二重送信防止

      setSending(true);
      status.hidden = true;

      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
          signal: controller.signal,
        });
        if (!res.ok) {
          // Formspreeは失敗理由をJSONの errors で返す(原因調査用にコンソールへ出す)
          const detail = await res.json().catch(() => null);
          console.warn('Formspree送信エラー', res.status, detail);
          throw new Error(`HTTP ${res.status}`);
        }

        form.reset();
        form.hidden = true;
        thanks.hidden = false;
        thanks.focus();
      } catch (error) {
        // 通信エラー・タイムアウト・Formspreeのエラー応答のいずれも、ここで表示する。
        // 入力内容はそのまま残し、もう一度送れるようにする
        console.warn('お問い合わせの送信に失敗しました', error);
        status.textContent = '送信できませんでした。時間をおいて、もう一度お試しください。';
        status.hidden = false;
      } finally {
        // 成功・失敗どちらでも「送信中」を必ず解除する
        clearTimeout(timer);
        setSending(false);
      }
    });
  }
</script>
